# Copy to .env and fill in. Never commit .env.

# Required for the AI twin (server-only, never prefix with NEXT_PUBLIC_).
OPENROUTER_API_KEY=

# Required for production builds (canonical, Open Graph, JSON-LD, sitemap).
# Example: https://agustinmohr.com
NEXT_PUBLIC_SITE_URL=

# Rate limit (defaults: 30 per client, 120 global, 10 min window).
# TWIN_RATE_LIMIT=30
# TWIN_GLOBAL_RATE_LIMIT=120
# TWIN_RATE_WINDOW_MS=600000

# Set to true only behind a trusted proxy; otherwise all visitors share one bucket.
# TWIN_TRUST_PROXY=true
# TWIN_TRUSTED_PROXY_HOPS=1

# Extra allowed origins for /api/twin (comma separated).
# TWIN_ALLOWED_ORIGINS=
# Local only: accept requests without an Origin header.
# TWIN_ALLOW_NO_ORIGIN=true

# Optional durable rate limit (Upstash Redis REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
